{
    "name": "maxcxam/larsadmin-medialibrary",
    "description": "spatie/laravel-medialibrary fields (single file and gallery) for the larsadmin admin panel.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "admin", "admin-panel", "larsadmin", "medialibrary", "uploads", "gallery"],
    "homepage": "https://github.com/maxcxam/larsadmin-medialibrary",
    "authors": [
        {
            "name": "Maksym Rudenko",
            "email": "maxcxam1979@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/maxcxam/larsadmin-medialibrary/issues",
        "source": "https://github.com/maxcxam/larsadmin-medialibrary"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../larsadmin",
            "options": {
                "symlink": true,
                "versions": {
                    "maxcxam/larsadmin": "1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": "^8.3",
        "maxcxam/larsadmin": "^1.6",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/temporary-directory": "^2.2"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "symfony/yaml": "^7.2|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Maxcxam\\LarsadminMedialibrary\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maxcxam\\LarsadminMedialibrary\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Maxcxam\\LarsadminMedialibrary\\MedialibraryServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
