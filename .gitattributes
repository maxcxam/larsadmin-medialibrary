# Line endings: normalise every text file to LF in the repository and in checkouts
# (overrides a contributor's core.autocrlf). Binary files are detected automatically by "text=auto".
* text=auto eol=lf

# Built frontend assets: generated by `npm run build`, collapsed in diffs on GitHub.
/dist/** linguist-generated=true -diff

# Excluded from the Composer dist archive (`composer require` with --prefer-dist, design 1.0 §5.3, ADR-045).
# They stay in the git repository; a --prefer-source install or a clone still has them.
# Kept in the archive: src/, dist/, lang/, database/, docs/, resources/boost/, LICENSE, CHANGELOG.md, README.md,
# SECURITY.md, composer.json.
#
# Development and CI only. composer.monorepo.json is the monorepo development manifest (path repository to
# ../larsadmin); consumers never need it.
/.github export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/tests export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/composer.monorepo.json export-ignore
#
# Frontend sources and build tooling. The service provider serves the prebuilt /dist, so the Vue/CSS sources
# are not needed at runtime; rebuilding the UI is done from a clone of the repository.
/resources/js export-ignore
/resources/css export-ignore
/package.json export-ignore
/package-lock.json export-ignore
/vite.config.js export-ignore
/vitest.config.js export-ignore
*.test.js export-ignore
